# 本機 PowerShell 開發專用（start-dev.ps1 / start-full.ps1）
# 複製：Copy-Item .env.local.example .env.local
#
# Docker 部署請用 .env（docker compose），勿與本檔混用。

# ── 前端 HMR（瀏覽器請開 FRONTEND_HOSTNAME，勿用 :8080）──
FRONTEND_HMR=true
FRONTEND_HOSTNAME=http://localhost:8010
DJANGO_HOSTNAME=http://localhost:8080

# 區網存取（.\start-full.ps1）時改為本機 IP，例如：
# FRONTEND_HOSTNAME=http://10.214.57.66:8010
# DJANGO_HOSTNAME=http://10.214.57.66:8080

# ── Triton 模型目錄 ──
TRITON_MODEL_REPOSITORY=./data/triton_models

# ── Redis / RQ（需先執行 .\start-redis.ps1）──
REDIS_URL=redis://localhost:6379/0
# RQ_REDIS_HOST=localhost
# RQ_REDIS_PORT=6379
# RQ_REDIS_DB=0

# ── 選填：Triton / Train Server 預設值 ──
# TRITON_SERVER_URL=http://localhost:8000
# TRAIN_SERVER_URL=http://localhost:8011
# TRAIN_SERVER_API_KEY=
