# NVIDIA DGX Spark（GB10）正式部署用環境變數範本
# 用法（在 Spark 本機）：
#   cp .env.spark.example .env
#   # 將下方 <Spark-IP> 換成 Spark 區網 IP（例如 10.214.57.20）
#   docker compose -f docker-compose.full.yml -f docker-compose.spark.yml up --build -d
#
# 重要：
# - 必須在 Spark 本機 build（aarch64 + CUDA 13），勿從 Windows/x86 搬映像
# - 瀏覽器網址須與 LABEL_STUDIO_HOST 一致（含埠號）
# - 同網段他機若只連本機 Train／Triton，可只設對應 URL（見檔案底部）

# ── 對外入口（必填：改成實際區網 IP）──
LABEL_STUDIO_HOST=http://<Spark-IP>:8080
CSRF_TRUSTED_ORIGINS=http://<Spark-IP>:8080

# ── 同機全堆疊內部連線（compose 預設即可，通常不用改）──
# TRAIN_SERVER_URL=http://train-server:8011
# TRITON_SERVER_URL=http://triton:8000
TRAIN_SERVER_API_KEY=

# ── 資料目錄 ──
TRITON_MODEL_REPOSITORY=./data/triton_models
# POSTGRES_DATA_DIR=./postgres-data

# ── 區網擴展：他機連本 Spark 的 GPU 服務範例 ──
# （在「第二台」的 .env / .env.local 填寫，不是本檔）
# TRAIN_SERVER_URL=http://<Spark-IP>:8011
# TRITON_SERVER_URL=http://<Spark-IP>:18000
# TRITON_UPLOAD_SERVER_PORT=18003
