# 複製為 .env 後依本機環境調整：cp .env.example .env（Unix）或 Copy-Item .env.example .env（Windows）

# ── 前端 HMR（僅本機開發 start-dev.ps1；Docker app-only 會強制 FRONTEND_HMR=false）──
FRONTEND_HMR=true
FRONTEND_HOSTNAME=http://localhost:8010
DJANGO_HOSTNAME=http://localhost:8080

# ── 本機 Redis / RQ（需先執行 .\start-redis.ps1）──
REDIS_URL=redis://localhost:6379/0
RQ_REDIS_HOST=localhost
RQ_REDIS_PORT=6379
RQ_REDIS_DB=0

# ── Triton Inference Server ──
# 本機 dev：模型目錄與 Triton 容器 -v 來源一致；預設為專案 data/triton_models
# Windows 範例：TRITON_MODEL_REPOSITORY=D:\path\to\data\triton_models
TRITON_MODEL_REPOSITORY=./data/triton_models
# 請填完整 URL（含埠號）。範例：本機 start-triton → :8000；Docker 對外 → :18000
# TRITON_SERVER_URL=http://localhost:8000
# TRITON_SERVER_URL=http://192.168.1.10:18000
# 遠端部署至 triton-server/docker-compose 時，Upload Server 對外埠為 18003（可由 18000 自動推導）
# TRITON_UPLOAD_SERVER_PORT=18003

# ── Train Server（獨立 YOLO 訓練微服務，選用）──
# 未設定時 YOLO 任務走本機 RQ；設定後 Django 轉發至 Train Server
# 請填完整 URL（含埠號），例如：
# TRAIN_SERVER_URL=http://localhost:8011
# TRAIN_SERVER_URL=http://192.168.1.10:8011
# TRAIN_SERVER_API_KEY=your-secret
# Docker Train Server（本機 localhost:8011 + ./data:/data）時可設 /data。
# 遠端 Train Server（另一台機器 / LAN IP）請勿設 TRAIN_SERVER_SHARED_DATA_ROOT，會自動 zip 上傳。
# 若遠端與本機共用 NFS，可設共享根目錄並加 TRAIN_SERVER_FORCE_SHARED_PATH=1：
# TRAIN_SERVER_SHARED_DATA_ROOT=/mnt/shared/label-studio/data
# TRAIN_SERVER_FORCE_SHARED_PATH=1

# ── Docker 預設（docker-compose.yml，僅 Label Studio 本體）──
# 只啟動 nginx + app（SQLite + 容器內嵌 Redis）；Triton / Train Server 不會啟動。
# 啟動：docker compose up --build -d
# 需要背景佇列時加 --profile worker
# 完整堆疊（PostgreSQL + Triton + Train Server）：docker compose -f docker-compose.full.yml up --build -d
#
# 若要用外部 PostgreSQL / Redis / Triton / Train Server，可在 .env 設定下列變數：
#
# 預設不設 DB 變數 → compose 使用 SQLite（./data/label_studio.sqlite3）+ 容器內嵌 Redis
#
# 容器連「同一台主機」上的服務：用 host.docker.internal（compose 已加 extra_hosts）
# 連「另一台機器」：改為該機 IP 或網域名稱
#
# 區網 Docker 存取（瀏覽器開 http://<本機IP>:8080 時必填，兩者須一致）：
# LABEL_STUDIO_HOST=http://10.214.57.66:8080
# CSRF_TRUSTED_ORIGINS=http://10.214.57.66:8080
#
# 外部 PostgreSQL 範例：
# DJANGO_DB=default
# POSTGRE_HOST=host.docker.internal
# POSTGRE_PORT=5432
# POSTGRE_USER=postgres
# POSTGRE_PASSWORD=your-password
# POSTGRE_NAME=postgres
# REDIS_URL=redis://host.docker.internal:6379/0
# REDIS_ENABLED=1
# TRITON_SERVER_URL=http://host.docker.internal:18000
# TRITON_MODEL_REPOSITORY=/label-studio/data/triton_models
# TRAIN_SERVER_URL=http://host.docker.internal:8011
# TRAIN_SERVER_API_KEY=your-secret
# LABEL_STUDIO_HOST=http://192.168.1.10:8080

# ── Docker Compose 全堆疊（docker-compose.full.yml，覆寫於 compose environment）──
# LABEL_STUDIO_HOST=http://192.168.1.10:8080
# POSTGRES_DATA_DIR=./postgres-data
