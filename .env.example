# 複製為 .env 後依本機環境調整：cp .env.example .env（Unix）或 Copy-Item .env.example .env（Windows）

# ── 前端 HMR（本機開發）──
FRONTEND_HMR=true
FRONTEND_HOSTNAME=http://localhost:8010
DJANGO_HOSTNAME=http://localhost:8080

# ── 本機 Redis / RQ（需先執行 .\start-redis.ps1）──
REDIS_URL=redis://localhost:6379/0
RQ_REDIS_HOST=localhost
RQ_REDIS_PORT=6379
RQ_REDIS_DB=0

# ── Triton Inference Server ──
# 本機 dev：模型目錄與 Triton 容器 -v 來源一致；預設為專案 data/triton_models
# Windows 範例：TRITON_MODEL_REPOSITORY=D:\path\to\data\triton_models
TRITON_MODEL_REPOSITORY=./data/triton_models
# 本機 dev Triton HTTP（容器對外 8000）
TRITON_SERVER_URL=http://localhost:8000

# ── Train Server（獨立 YOLO 訓練微服務，選用）──
# 未設定時 YOLO 任務走本機 RQ；設定後 Django 轉發至 Train Server
# Docker Compose 預設：http://train-server:8011
TRAIN_SERVER_URL=http://localhost:8011
# TRAIN_SERVER_API_KEY=your-secret

# ── Docker Compose 部署（覆寫於 compose environment，通常不需改 .env）──
# LABEL_STUDIO_HOST=http://localhost:8080
# POSTGRES_DATA_DIR=./postgres-data
