# syntax=docker/dockerfile:1
# Label Studio Train Server — 獨立 YOLO 訓練容器（含 ultralytics / torch）

# ── 建置 ──────────────────────────────────────────────────────────────────────
# docker build -f Dockerfile.train-server -t labelstudio-train-server:latest .
#
# ── NVIDIA DGX Spark（GB10 / aarch64 / CUDA 13）─────────────────────────────
# 必須在 Spark 本機建置（linux/arm64），勿在 Windows/x86 建好再搬過去。
#   uname -m   # 應為 aarch64
#   docker build --no-cache -f Dockerfile.train-server -t labelstudio-train-server:latest .
#   docker rm -f train-server
#   docker run -d --name train-server --gpus all --ipc=host -p 8011:8011 \
#     --restart unless-stopped labelstudio-train-server:latest
# 驗證：curl http://localhost:8011/health  → torch_version 含 cu130、cuda_kernel_usable=true
# 若日誌出現整段 #ifdef __HIPCC__ / NVRTC：幾乎都是 cu12x wheel + CUDA 13 混用，請用上方 cu130 重建。
#
# ── 首次部署（一般 x86 GPU：不掛 volume，Label Studio 以 zip 上傳資料集）──
# docker run -d --name train-server --gpus all -p 8011:8011 --restart unless-stopped labelstudio-train-server:latest
#
# ── 首次部署（選用：與 Label Studio 共用本機 data/，可略過 zip 上傳）────────
# docker run -d --name train-server --gpus all -p 8011:8011 --restart unless-stopped `
#   -v "D:\ai_test\project\label-studio\data:/data" `
#   labelstudio-train-server:latest
# Linux / macOS 將 -v 改為：-v ./data:/data
#
# ── 更新與重新部署（改 train_server/ 或本 Dockerfile 後）────────────────────
# docker stop train-server
# docker rm train-server
# docker build -f Dockerfile.train-server -t labelstudio-train-server:latest .
# docker run -d --name train-server --gpus all -p 8011:8011 --restart unless-stopped labelstudio-train-server:latest
# 若需保留 volume 掛載，run 時加上相同的 -v 參數
#
# ── 常用管理 ──────────────────────────────────────────────────────────────────
# docker ps --filter name=train-server
# docker logs -f train-server
# curl http://localhost:8011/health
# .\scripts\test-train-server-health.ps1
#
# ── 備註 ──────────────────────────────────────────────────────────────────────
# • 預設 DataLoader workers=0（Docker /dev/shm 不足時 workers>0 會 bus error）；要加速可 run 加：
#   --shm-size=2g -e TRAIN_SERVER_DATALOADER_WORKERS=4
# • 預設優先 GPU（需 --gpus all + NVIDIA Container Toolkit）；無 GPU 時自動用 CPU
# • DGX Spark / GB10：務必 cu130 + arm64 本機 build；sm_121 警告可忽略（與 sm_120 相容）
# • 一般 Blackwell（RTX 50）：cu128 亦可，預設改 cu130 通常仍相容（驅動需夠新）
# • 暫時純 CPU：-e TRAIN_SERVER_DEVICE=cpu
# • 不掛 -v 時：訓練產物在容器內，刪容器會消失；Label Studio 透過 API 取回 best.pt
# • 掛 -v ./data:/data 時：與 Label Studio 共用資料集／模型目錄（Compose 預設行為）
# • Label Studio 連線：TRAIN_SERVER_URL=http://<Spark IP>:8011
# • 可選 API Key：run 加 -e TRAIN_SERVER_API_KEY=your-secret，Label Studio 端需一致
# • Docker Compose：docker compose up -d train-server（服務名 train-server，埠 8011）
ARG PYTHON_VERSION=3.12
# PyTorch CUDA 輪子：cu130 給 DGX Spark（CUDA 13 / aarch64）；亦適用新一代 Blackwell
ARG TORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu130

FROM python:${PYTHON_VERSION}-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TRAIN_SERVER_HOST=0.0.0.0 \
    TRAIN_SERVER_PORT=8011 \
    TRAIN_SERVER_OUTPUT_ROOT=/data/training/models/trained \
    TRAIN_SERVER_MODELS_DIR=/data/training/models/original \
    TRAIN_SERVER_MAX_WORKERS=1 \
    TRAIN_SERVER_DATALOADER_WORKERS=0

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY train_server/requirements-train.txt /app/train_server/requirements-train.txt
# CUDA 版 torch（預設 GPU；Spark 請用 cu130；強制 CPU：TRAIN_SERVER_DEVICE=cpu）
ARG TORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu130
RUN pip install --upgrade pip \
    && pip install "numpy>=1.26.4,<2.0" \
        "torch>=2.9.0" "torchvision>=0.24.0" \
        --index-url "${TORCH_CUDA_INDEX_URL}" \
    && pip install -r /app/train_server/requirements-train.txt

COPY train_server /app/train_server

EXPOSE 8011

VOLUME ["/data"]

CMD ["python", "-m", "train_server.main"]
