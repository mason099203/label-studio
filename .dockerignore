# Ignore everything:
**

# Except:
!deploy/docker-entrypoint.d/**
!deploy/docker-entrypoint.sh
!deploy/heroku_run.sh
!deploy/uwsgi.ini
!deploy/default.conf
!label_studio/**
# Re-ignore pyc files and frontend
label_studio/frontend
label_studio/**/*.pyc

# FRONTEND
!web
# Dockerfile 的 version 步驟使用 `--mount=bind,source=.git`：在 Docker Desktop / BuildKit 下，
# 若 `.git` 被排除，掛載會失敗（`"/.git": not found`）。因此必須保留 `!.git`。
# 若 context 過大，請在本機執行 `git gc`、或改用 shallow clone，而非從 .dockerignore 拿掉 .git。
!.git
# 本機已 build 的產物不必送入 context（映像內會執行 yarn build）
web/dist
# Re-ignore node_modules and nx cache
**/node_modules
**/.nx

!README.md
!licenses/**
!LICENSE
!pyproject.toml
!poetry.lock

# ---------------------------------------------------------------------------
# 縮小 build context（排除執行時資料與本機目錄；勿再排除 `.git`，見上方說明）
# ---------------------------------------------------------------------------
data/
mydata/
postgres-data/
redis-data/
.cursor/
